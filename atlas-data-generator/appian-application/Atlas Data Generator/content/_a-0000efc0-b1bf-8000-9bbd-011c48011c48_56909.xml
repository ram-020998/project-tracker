    <rule>
        <name>ADG_UT_returnRecordReferenceFromUuid</name>
        <uuid>_a-0000efc0-b1bf-8000-9bbd-011c48011c48_56909</uuid>
        <description>The rule is used to return record  reference from UUId</description>
        <parentUuid>9ea9a774-b9e7-4ea3-99ac-90d4b5788f91</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>eval(
  concat(
    "recordType!{",
    ri!recordTypeUuid,
    "}"
  )
)</definition>
        <namedTypedValue>
            <name>recordTypeUuid</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
