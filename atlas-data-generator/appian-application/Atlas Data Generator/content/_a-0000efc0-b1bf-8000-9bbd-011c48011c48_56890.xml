<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000efc0-b1bf-8000-9bbd-011c48011c48_56901</versionUuid>
    <rule>
        <name>ADG_UT_returnFieldReferenceFromFieldName</name>
        <uuid>_a-0000efc0-b1bf-8000-9bbd-011c48011c48_56890</uuid>
        <description>The rule is used to return field reference from field name</description>
        <parentUuid>9ea9a774-b9e7-4ea3-99ac-90d4b5788f91</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(
  a!isNullOrEmpty(value: ri!fieldName),
  {},
  a!localVariables(
    local!fields: ri!recordProperties.recordType.fields,
    displayvalue(
      ri!fieldName,
      local!fields.name,
      local!fields.reference,
      {}
    )
  )
)</definition>
        <namedTypedValue>
            <name>recordProperties</name>
            <type>
                <name>Map</name>
                <namespace>http://www.appian.com/ae/types/2009</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>fieldName</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
    <roleMap public="true">
        <role inherit="true" allowForAll="false" name="readers">
            <users/>
            <groups/>
        </role>
        <role inherit="true" allowForAll="false" name="authors">
