{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-manifest.schema.json",
  "title": "Sub-spec context manifest",
  "description": "The context block every future sub-spec carries; the build agent loads exactly this. Umbrella Phase 47 §4. gk context <sub-spec> resolves it deterministically.",
  "type": "object",
  "required": ["context"],
  "properties": {
    "context": {
      "type": "object",
      "required": ["areas"],
      "properties": {
        "areas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["engine", "runs-config", "data-plane", "workflow-library", "agent-sdk",
                     "chat-copilot", "appian-kb", "appian-parser", "feature-sdlc", "stories-workbench",
                     "collaboration-hub", "memory", "web-ui", "dev-release-ops", "all", "history"]
          }
        },
        "rules": {
          "type": "array",
          "items": {"type": "string", "pattern": "^(ADR|LSN|STD|WA)-[0-9]{3}$"},
          "description": "Extra rules to load beyond the areas' own.",
          "nullable": true
        },
        "read": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Repo-relative files the agent must read in full.",
          "nullable": true
        },
        "depends_on": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Sub-spec ids this one depends on.",
          "nullable": true
        }
      }
    }
  }
}
