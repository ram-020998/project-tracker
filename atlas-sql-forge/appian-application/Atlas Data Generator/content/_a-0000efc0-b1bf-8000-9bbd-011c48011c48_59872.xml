<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000efc0-b1bf-8000-9bbd-011c48011c48_59883</versionUuid>
    <rule>
        <name>ADG_UT_convertFieldValue</name>
        <uuid>_a-0000efc0-b1bf-8000-9bbd-011c48011c48_59872</uuid>
        <description>The rule to convert field values to proper formats</description>
        <parentUuid>9ea9a774-b9e7-4ea3-99ac-90d4b5788f91</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(
  a!isNullOrEmpty(ri!value),
  a!match(
    value: ri!fieldType,
    equals: "User",
    then: touser(null),
    equals: "Integer",
    then: tointeger(null),
    equals: "Decimal",
    then: todecimal(null),
    default: null
  ),
  a!match(
    value: ri!fieldType,
    equals: "Date",
    then: todate(ri!value),
    equals: "Datetime",
    then: todatetime(ri!value),
    equals: "User",
    then: touser(ri!value),
    equals: "Integer",
    then: tointeger(ri!value),
    equals: "Decimal",
    then: todecimal(ri!value),
    equals: "Boolean",
    then: cast(typeof(true), ri!value),
    default: tostring(ri!value)
  )
)</definition>
        <namedTypedValue>
            <name>value</name>
            <type>
                <name>Variant</name>
                <namespace>http://www.appian.com/ae/types/2009</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>fieldType</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
    <roleMap public="true">
